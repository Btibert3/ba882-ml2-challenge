# Copy this file to .env and fill in your values

TEAM_NAME=your-team-name

# API base URL — do not change this
API_BASE=https://btibert-bu--ba882-nba-ship-it

# Your deployed Cloud Function URL — fill in after running bash functions/deploy.sh
TRAIN_FUNCTION_URL=https://YOUR_FUNCTION_URL_HERE

# DuckDB path — shared between Airflow and dbt
DUCKDB_PATH=/usr/local/airflow/nba.duckdb

# dbt executable path — run this command to find yours on Cloud Shell:
#   which dbt
# Then set it here, e.g.:
#   DBT_EXECUTABLE_PATH=/home/YOUR_USERNAME/.local/bin/dbt
DBT_EXECUTABLE_PATH=/usr/local/airflow/dbt_venv/bin/dbt
