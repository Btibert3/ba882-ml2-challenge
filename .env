# ── Team Setup ──────────────────────────────────────────────────────────────
# Set your team number — this is what appears on the leaderboard
# Example: TEAM_NUMBER=3
TEAM_NUMBER=0

# ── API ─────────────────────────────────────────────────────────────────────
# Do not change this
API_BASE=https://btibert-bu--ba882-nba-ship-it

# ── Cloud Function ───────────────────────────────────────────────────────────
# After running: bash functions/deploy.sh
# Copy the URL it prints and paste it here
TRAIN_FUNCTION_URL=https://YOUR_FUNCTION_URL_HERE

# ── DuckDB ───────────────────────────────────────────────────────────────────
# Run this to set the correct path automatically:
#   echo "DUCKDB_PATH=$(pwd)/nba.duckdb" >> .env
DUCKDB_PATH=/home/YOUR_USERNAME/ba882-ml2-challenge/nba.duckdb

# ── dbt ──────────────────────────────────────────────────────────────────────
# After running: pip install dbt-duckdb
# Run: which dbt  — then update the path below
# Example:
#   DBT_EXECUTABLE_PATH=/home/btibert/.local/bin/dbt
DBT_EXECUTABLE_PATH=/home/YOUR_USERNAME/.local/bin/dbt
