# ── Team Setup ──────────────────────────────────────────────────────────────
# Set your team name — this is what appears on the leaderboard
TEAM_NAME=your-team-name

# ── API ─────────────────────────────────────────────────────────────────────
# Do not change this
API_BASE=https://btibert-bu--ba882-nba-ship-it

# ── Cloud Function ───────────────────────────────────────────────────────────
# After running: bash functions/deploy.sh
# Copy the URL it prints and paste it here
TRAIN_FUNCTION_URL=https://YOUR_FUNCTION_URL_HERE

# ── DuckDB ───────────────────────────────────────────────────────────────────
# Run this command to set the correct path for your Cloud Shell session:
#   echo "DUCKDB_PATH=$(pwd)/nba.duckdb" >> .env
DUCKDB_PATH=/home/user/ba882-ml2-challenge/nba.duckdb

# ── dbt ──────────────────────────────────────────────────────────────────────
# After running: pip install dbt-duckdb
# Run: which dbt  — then paste the path here
DBT_EXECUTABLE_PATH=/home/user/.local/bin/dbt
